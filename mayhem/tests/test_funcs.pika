def fib(n):
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)
print(fib(15))
def add(x, y=10):
    return x + y
print(add(1), add(1, 2))
class Counter:
    def __init__(self):
        self.v = 0
    def inc(self, k):
        self.v += k
        return self.v
c = Counter()
c.inc(3)
print(c.inc(4))
total = 0
for i in range(10):
    if i % 2 == 0:
        continue
    total += i
print(total)
